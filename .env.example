# Copy this file to .env and replace the values. The real .env is never committed.

# Database password. Use only letters and numbers (it goes inside a URL). Generate with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Signs session cookies so they can't be forged. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me

# true = cookies are only sent over HTTPS. Keep false while testing on your
# home network (http://), switch to true once the API is on https://api.taraskoval.ca
COOKIE_SECURE=false
