# Copy this file to .env and replace the values. The real .env is never committed.

# Database password. Use only letters and numbers (it goes inside a URL). Generate with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Signs session cookies so they can't be forged. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me

# true = cookies are only sent over HTTPS (correct now that the API is on https://)
COOKIE_SECURE=true

# The address people use to reach the API. Used to build subscription links.
PUBLIC_API_URL=https://api.taraskoval.ca

# Websites allowed to call the API from a browser (comma-separated).
ALLOWED_ORIGINS=https://calendar.taraskoval.ca

# From Cloudflare: Zero Trust → Networks → Tunnels → your tunnel (the long token).
CLOUDFLARE_TUNNEL_TOKEN=change-me
